# --- server/.env (copy this file to server/.env) ---
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/interviewai   # REQUIRED
JWT_SECRET=                                         # REQUIRED, 32+ random chars
CLIENT_URL=http://localhost:5173
NODE_ENV=development
COOKIE_SAMESITE=lax                                 # use "none" only if client/API are on different sites (needs HTTPS)
AI_PROVIDER=openai-compatible                       # any OpenAI-compatible /chat/completions API
AI_API_KEY=                                         # REQUIRED for question generation + evaluation
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
